{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/server",
    "src/domains",
    "src/utils/**/*.ts",
    "test/helpers.ts"
  ],
  "exclude": [
    "src/utils/hooks.ts",
    "src/**/*.test.tsx"
  ]
}
