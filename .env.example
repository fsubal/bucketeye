# ---- 必須 ----
S3_BUCKET=                      # レビュー対象のバケット
AUTH_PROVIDER=                  # gcp_iap | aws_alb | cloudflare_access | forwarded_header | developer

# ---- S3 互換ストレージ ----
S3_ENDPOINT=                    # MinIO / RustFS / Ceph / GCS(S3 互換) のとき。AWS S3 なら空
S3_PUBLIC_ENDPOINT=             # presigned URL に使う、ブラウザから見えるエンドポイント。空なら S3_ENDPOINT
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=               # 空なら SDK の既定の認証チェーン（IAM ロール等）
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=            # 空なら S3_ENDPOINT があるとき true
TARGET_PREFIX=                  # レビュー対象の prefix。空で全体
REVIEW_BUCKET=                  # コメント等のサイドカーを置くバケット。空なら S3_BUCKET
REVIEW_PREFIX=.review/          # サイドカーの prefix
STATUS_STRATEGY=tags            # tags（S3/MinIO/RustFS/Ceph）| sidecar（GCS などタグが無いとき）
PRESIGN_EXPIRES_IN=900

# ---- 認証 ----
ADMIN_EMAILS=                   # カンマ区切り。Webhook 管理や再索引ができる人
API_TOKENS=                     # カンマ区切り。/api/v1 の Bearer トークン
SECRET_KEY=                     # developer のクッキー署名にだけ使う
IAP_AUDIENCE=                   # gcp_iap: /projects/<番号>/global/backendServices/<ID>
ALB_REGION=                     # aws_alb: ALB のリージョン（AWS_REGION でも可）
ALB_ARN=                        # aws_alb: 任意。JWT の signer と照合する
CF_ACCESS_TEAM_DOMAIN=          # cloudflare_access: myteam.cloudflareaccess.com
CF_ACCESS_AUD=                  # cloudflare_access: Application Audience タグ
AUTH_EMAIL_HEADER=X-Forwarded-Email                 # forwarded_header
AUTH_NAME_HEADER=X-Forwarded-Preferred-Username     # forwarded_header
AUTH_ALLOW_DEVELOPER_IN_PRODUCTION=false            # developer をデモ目的で production で使うときだけ true

# ---- 運用 ----
PORT=3000
DATA_DIR=./data                 # SQLite の置き場。消えても S3 から再索引で復元される
PUBLIC_URL=                     # Webhook のペイロードに入れる詳細画面 URL の元（例 https://review.example.com）
REINDEX_ON_BOOT=true
REINDEX_EVERY=10m               # 定期再索引の間隔（10m / 1h / 30s）
WEBHOOK_WORKER_INTERVAL=2s
